<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>My Portfolio</title>

  <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">

  <style>
    *{
      margin:0;
      padding:0;
      box-sizing:border-box;
      font-family: 'Poppins', sans-serif;
    }

    body{
      background: linear-gradient(135deg, #0f2027, #2c5364);
      color:#fff;
      scroll-behavior:smooth;
    }

    header{
      height:100vh;
      display:flex;
      flex-direction:column;
      justify-content:center;
      align-items:center;
      text-align:center;
    }

    header h1{
      font-size:3rem;
      font-weight:600;
      animation: popup 1s ease;
    }

    header p{
      margin-top:10px;
      font-size:1.2rem;
      font-weight:300;
      animation: popup 1.5s ease;
    }

    @keyframes popup{
      0%{
        transform: scale(0);
        opacity:0;
      }
      100%{
        transform: scale(1);
        opacity:1;
      }
    }

    nav{
      position:fixed;
      top:0;
      width:100%;
      background:rgba(0,0,0,0.6);
      padding:12px;
      text-align:center;
    }

    nav a{
      color:white;
      margin:0 15px;
      text-decoration:none;
      transition:0.3s;
      font-weight:500;
    }

    nav a:hover{
      color:#00e6e6;
    }

    section{
      padding:80px 20px;
      text-align:center;
    }

    h2{
      margin-bottom:20px;
      font-size:2rem;
      font-weight:500;
    }

    .card{
      background:rgba(255,255,255,0.1);
      padding:20px;
      margin:15px;
      border-radius:15px;
      display:inline-block;
      width:250px;
      transition:0.3s;
    }

    .card:hover{
      transform:translateY(-10px) scale(1.05);
      background:rgba(255,255,255,0.2);
    }

    footer{
      text-align:center;
      padding:20px;
      background:rgba(0,0,0,0.6);
      font-weight:300;
    }

    @media(max-width:768px){
      header h1{
        font-size:2rem;
      }
    }
  </style>
</head>
<body>

<nav>
  <a href="#about">About 👩‍💻</a>
  <a href="#projects">Projects 🚀</a>
  <a href="#skills">Skills 💡</a>
  <a href="#contact">Contact 📩</a>
</nav>

<header>
  <h1>Hi, I'm Dharshini ✨</h1>
  <p>🌱 Aspiring Developer | 💻 C Learner | 🎯 Future Engineer</p>
</header>

<section id="about">
  <h2>About Me 🌸</h2>
  <p>I'm a passionate student learning programming and building my skills step by step. I enjoy creating simple projects and improving every day 🚀</p>
</section>

<section id="projects">
  <h2>Projects 🚀</h2>
  <div class="card">🧮 Calculator Project</div>
  <div class="card">🌐 Portfolio Website</div>
  <div class="card">💻 Mini C Programs</div>
</section>

<section id="skills">
  <h2>Skills 💡</h2>
  <div class="card">💻 C Programming</div>
  <div class="card">🎨 HTML & CSS</div>
  <div class="card">⚡ Basic JavaScript</div>
</section>

<section id="contact">
  <h2>Contact 📩</h2>
  <p>Email: dharshpersonal26@gmail.com</p>
</section>

<footer>
  <p>© 2026 Dharshini 💖</p>
</footer>

</body>
</html>
